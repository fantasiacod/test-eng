{#
| Variable            | Type     | Description            |
|---------------------|----------|------------------------|
| component.items[]   | object[] | icon / title / text    |
#}
<section component-id="{{ componentId }}" class="s-block tq-features">
  <div class="container">
    <div class="tq-features__grid">
      {% for item in component.items %}
        <div class="tq-feature">
          <i class="{{ item.icon }}"></i>
          <div>
            <strong>{{ item.title }}</strong>
            <small>{{ item.text }}</small>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
